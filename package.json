{
  "name": "@local/quick-search",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "description": "Search-only quick-answer mode for a configurable work directory.",
  "exports": {
    ".": "./index.js",
    "./policy": "./policy.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "search.js",
    "citation.js",
    "prompt.js",
    "policy.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
